@@ -0,0 +1,357 @@
+//! User-defined spawn shortcuts.
+//!
+//! Denial's window-management shortcuts are compiled in and deliberately fixed:
+//! they are part of the shell contract and are dispatched to Flutter. This
+//! module adds a strictly separate table of `Super`-chorded bindings that
+//! launch a process instead, so a user can bind a launcher or a terminal
+//! without the compositor growing a general-purpose input rebinding layer.
+//!
+//! Bindings are read once at startup from `$XDG_CONFIG_HOME/denial/keybinds.conf`
+//! (falling back to `$HOME/.config`). A missing file is the normal case and is
+//! not an error. Malformed lines are reported and skipped: a typo must never
+//! cost the user a session.
+//!
+//! ```text
+//! # Denial spawn shortcuts
+//! Super+Space  = /usr/bin/anchovy
+//! Super+Return = alacritty
+//! Super+Shift+E = thunar --new-window
+//! ```
+
+use std::path::PathBuf;
+use std::sync::{PoisonError, RwLock};
+
+use tracing::{info, warn};
+
+/// Keys that already carry a compiled-in window-management action. A user
+/// binding on one of these would never be reached, so it is refused loudly
+/// rather than silently ignored.
+const RESERVED_KEYCODES: &[(u32, &str)] = &[
+    (1, "Escape"),
+    (15, "Tab"),
+    (30, "A"),
+    (33, "F"),
+    (37, "K"),
+    (38, "L"),
+    (47, "V"),
+    (50, "M"),
+    (103, "Up"),
+];
+
+const MAX_BINDINGS: usize = 64;
+
+static BINDINGS: RwLock<Vec<SpawnBinding>> = RwLock::new(Vec::new());
+
+#[derive(Debug, Clone, Eq, PartialEq)]
+struct SpawnBinding {
+    keycode: u32,
+    /// Whether the chord requires Shift. Matching is exact in both directions,
+    /// so `Super+E` does not fire while Shift is held and `Super+Shift+E` does
+    /// not fire without it.
+    shift: bool,
+    command: Vec<String>,
+}
+
+/// Load the binding table during startup, so no key event performs file I/O on
+/// the input path.
+pub(super) fn initialize() {
+    store(read_configuration());
+}
+
+/// Re-read the configuration in place, for SIGHUP.
+///
+/// A file that has become unreadable or entirely malformed yields an empty
+/// table, which is reported rather than silently retaining stale bindings: the
+/// user asked for what is on disk now.
+pub(super) fn reload() {
+    let bindings = read_configuration();
+    info!(count = bindings.len(), "reloaded spawn shortcuts");
+    store(bindings);
+}
+
+/// Whether any binding uses this key, regardless of its modifiers.
+pub(super) fn is_bound(evdev_keycode: u32) -> bool {
+    read()
+        .iter()
+        .any(|binding| binding.keycode == evdev_keycode)
+}
+
+/// Index of the binding matching this key and Shift state exactly.
+pub(super) fn index_of(evdev_keycode: u32, shift: bool) -> Option<usize> {
+    read()
+        .iter()
+        .position(|binding| binding.keycode == evdev_keycode && binding.shift == shift)
+}
+
+/// The command at this index, cloned so the lock is not held across a fork.
+pub(super) fn command_at(index: usize) -> Option<Vec<String>> {
+    read().get(index).map(|binding| binding.command.clone())
+}
+
+/// Read the table, recovering from poisoning rather than panicking: a stale
+/// binding list is always better than killing the compositor from the input
+/// path.
+fn read() -> impl std::ops::Deref<Target = Vec<SpawnBinding>> {
+    BINDINGS.read().unwrap_or_else(PoisonError::into_inner)
+}
+
+fn store(bindings: Vec<SpawnBinding>) {
+    *BINDINGS.write().unwrap_or_else(PoisonError::into_inner) = bindings;
+}
+
+fn read_configuration() -> Vec<SpawnBinding> {
+    match configuration_path() {
+        Some(path) => load_from(&path),
+        None => {
+            warn!("neither XDG_CONFIG_HOME nor HOME is set; spawn shortcuts are disabled");
+            Vec::new()
+        }
+    }
+}
+
+fn configuration_path() -> Option<PathBuf> {
+    if let Some(config_home) = std::env::var_os("XDG_CONFIG_HOME")
+        && !config_home.is_empty()
+    {
+        return Some(PathBuf::from(config_home).join("denial/keybinds.conf"));
+    }
+    let home = std::env::var_os("HOME")?;
+    if home.is_empty() {
+        return None;
+    }
+    Some(PathBuf::from(home).join(".config/denial/keybinds.conf"))
+}
+
+fn load_from(path: &PathBuf) -> Vec<SpawnBinding> {
+    let contents = match std::fs::read_to_string(path) {
+        Ok(contents) => contents,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Vec::new(),
+        Err(error) => {
+            warn!(path = %path.display(), "could not read spawn shortcuts: {error}");
+            return Vec::new();
+        }
+    };
+
+    let mut bindings: Vec<SpawnBinding> = Vec::new();
+    for (index, line) in contents.lines().enumerate() {
+        let number = index + 1;
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let binding = match parse_line(line) {
+            Ok(binding) => binding,
+            Err(error) => {
+                warn!(path = %path.display(), line = number, "ignoring spawn shortcut: {error}");
+                continue;
+            }
+        };
+        if bindings.len() >= MAX_BINDINGS {
+            warn!(
+                path = %path.display(),
+                line = number,
+                limit = MAX_BINDINGS,
+                "ignoring spawn shortcut beyond the binding limit"
+            );
+            continue;
+        }
+        // Later duplicates would be unreachable, so report instead of shadowing.
+        if let Some(existing) = bindings
+            .iter()
+            .find(|existing| existing.keycode == binding.keycode && existing.shift == binding.shift)
+        {
+            warn!(
+                path = %path.display(),
+                line = number,
+                bound_to = existing.command[0],
+                "ignoring spawn shortcut that repeats an earlier chord"
+            );
+            continue;
+        }
+        bindings.push(binding);
+    }
+
+    if !bindings.is_empty() {
+        info!(count = bindings.len(), path = %path.display(), "loaded spawn shortcuts");
+    }
+    bindings
+}
+
+fn parse_line(line: &str) -> Result<SpawnBinding, String> {
+    let (chord, command) = line
+        .split_once('=')
+        .ok_or_else(|| format!("expected `Chord = command`, got `{line}`"))?;
+
+    let command: Vec<String> = command.split_whitespace().map(str::to_owned).collect();
+    if command.is_empty() {
+        return Err("binding has no command".to_owned());
+    }
+
+    let mut super_seen = false;
+    let mut shift = false;
+    let mut key = None;
+    for token in chord.split('+') {
+        let token = token.trim();
+        if token.is_empty() {
+            return Err(format!("chord `{}` has an empty component", chord.trim()));
+        }
+        match token.to_ascii_lowercase().as_str() {
+            "super" | "meta" | "logo" => super_seen = true,
+            "shift" => shift = true,
+            _ => {
+                if key.replace(token).is_some() {
+                    return Err(format!("chord `{}` names more than one key", chord.trim()));
+                }
+            }
+        }
+    }
+
+    // Every compiled-in shortcut is Super-chorded, and the state machine only
+    // consults this table while Super is held. A binding without it could never
+    // fire, so refuse it at parse time instead of at the keyboard.
+    if !super_seen {
+        return Err(format!("chord `{}` must include Super", chord.trim()));
+    }
+    let key = key.ok_or_else(|| format!("chord `{}` names no key", chord.trim()))?;
+    let keycode =
+        keycode_for_name(key).ok_or_else(|| format!("unknown key name `{key}` in chord"))?;
+    if let Some((_, name)) = RESERVED_KEYCODES
+        .iter()
+        .find(|(reserved, _)| *reserved == keycode)
+    {
+        return Err(format!(
+            "Super+{name} is a built-in window-management shortcut and cannot be rebound"
+        ));
+    }
+
+    Ok(SpawnBinding {
+        keycode,
+        shift,
+        command,
+    })
+}
+
+/// Map a configuration key name to its Linux evdev keycode.
+///
+/// Names are positional, matching how the compositor reads hardware: they
+/// follow the US layout's legends regardless of the active XKB layout, exactly
+/// like the compiled-in shortcuts.
+fn keycode_for_name(name: &str) -> Option<u32> {
+    let lowered = name.to_ascii_lowercase();
+    let named = match lowered.as_str() {
+        "escape" | "esc" => 1,
+        "minus" => 12,
+        "equal" => 13,
+        "backspace" => 14,
+        "tab" => 15,
+        "leftbracket" => 26,
+        "rightbracket" => 27,
+        "return" | "enter" => 28,
+        "semicolon" => 39,
+        "apostrophe" => 40,
+        "grave" => 41,
+        "backslash" => 43,
+        "comma" => 51,
+        "period" | "dot" => 52,
+        "slash" => 53,
+        "space" => 57,
+        "home" => 102,
+        "up" => 103,
+        "pageup" => 104,
+        "left" => 105,
+        "right" => 106,
+        "end" => 107,
+        "down" => 108,
+        "pagedown" => 109,
+        "insert" => 110,
+        "delete" => 111,
+        _ => 0,
+    };
+    if named != 0 {
+        return Some(named);
+    }
+
+    if let Some(number) = lowered.strip_prefix('f')
+        && let Ok(index) = number.parse::<u32>()
+    {
+        return match index {
+            1..=10 => Some(58 + index),
+            11 => Some(87),
+            12 => Some(88),
+            _ => None,
+        };
+    }
+
+    let mut characters = lowered.chars();
+    let single = characters.next()?;
+    if characters.next().is_some() {
+        return None;
+    }
+    match single {
+        'a'..='z' => {
+            const LETTER_ROWS: [&str; 3] = ["qwertyuiop", "asdfghjkl", "zxcvbnm"];
+            const ROW_FIRST_KEYCODE: [u32; 3] = [16, 30, 44];
+            LETTER_ROWS.iter().enumerate().find_map(|(row, letters)| {
+                letters
+                    .find(single)
+                    .map(|column| ROW_FIRST_KEYCODE[row] + u32::try_from(column).unwrap_or(0))
+            })
+        }
+        // The digit row runs 1..9 then 0, which is not the ASCII order.
+        '1'..='9' => Some(u32::from(single as u8 - b'1') + 2),
+        '0' => Some(11),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_a_plain_super_binding() {
+        let binding = parse_line("Super+Space = /usr/bin/anchovy").expect("binding parses");
+        assert_eq!(binding.keycode, 57);
+        assert!(!binding.shift);
+        assert_eq!(binding.command, vec!["/usr/bin/anchovy".to_owned()]);
+    }
+
+    #[test]
+    fn keeps_command_arguments_and_accepts_modifier_aliases() {
+        let binding = parse_line("meta + shift + e = thunar --new-window").expect("binding parses");
+        assert_eq!(binding.keycode, 18);
+        assert!(binding.shift);
+        assert_eq!(
+            binding.command,
+            vec!["thunar".to_owned(), "--new-window".to_owned()]
+        );
+    }
+
+    #[test]
+    fn maps_letter_rows_and_the_digit_row_positionally() {
+        assert_eq!(keycode_for_name("q"), Some(16));
+        assert_eq!(keycode_for_name("p"), Some(25));
+        assert_eq!(keycode_for_name("a"), Some(30));
+        assert_eq!(keycode_for_name("z"), Some(44));
+        assert_eq!(keycode_for_name("m"), Some(50));
+        assert_eq!(keycode_for_name("1"), Some(2));
+        assert_eq!(keycode_for_name("9"), Some(10));
+        assert_eq!(keycode_for_name("0"), Some(11));
+        assert_eq!(keycode_for_name("F1"), Some(59));
+        assert_eq!(keycode_for_name("f10"), Some(68));
+        assert_eq!(keycode_for_name("f11"), Some(87));
+        assert_eq!(keycode_for_name("f12"), Some(88));
+        assert_eq!(keycode_for_name("f13"), None);
+        assert_eq!(keycode_for_name("nonsense"), None);
+    }
+
+    #[test]
+    fn refuses_bindings_that_could_never_fire() {
+        assert!(parse_line("Ctrl+Space = anchovy").is_err());
+        assert!(parse_line("Super+K = anchovy").is_err());
+        assert!(parse_line("Super+Space =").is_err());
+        assert!(parse_line("Super+Nope = anchovy").is_err());
+        assert!(parse_line("Super+A+B = anchovy").is_err());
+        assert!(parse_line("no equals sign").is_err());
+    }
+}
