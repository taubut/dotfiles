+/// Release planes the previous DRM master left latched on this device.
+///
+/// Denial draws its pointer inside the Flutter scene and never programs a
+/// hardware cursor plane. A predecessor on the same device - the
+/// `kwin_wayland` SDDM greeter, for example - leaves its own cursor bound to
+/// that plane when it exits, and the kernel keeps scanning the plane out above
+/// the Denial atlas for the rest of the session. The image is not part of the
+/// scene graph, so no repaint, client teardown, or Xwayland exit can clear it.
+/// Overlay planes are inherited the same way. Drop every non-primary plane
+/// that still holds a framebuffer; the atlas owns the primary planes and
+/// programs them itself.
+///
+/// A driver that refuses the commit only leaves the stale image on screen, so
+/// this never fails session startup.
+pub(super) fn release_inherited_planes(drm: &DrmDevice) {
+    let request = match inherited_plane_request(drm) {
+        Ok(Some(request)) => request,
+        Ok(None) => return,
+        Err(error) => {
+            warn!("could not inspect planes inherited from the previous DRM master: {error}");
+            return;
+        }
+    };
+
+    // Validate before committing, matching the teardown path's handling of
+    // driver-specific atomic rejections.
+    if let Err(error) = drm.atomic_commit(
+        AtomicCommitFlags::ALLOW_MODESET | AtomicCommitFlags::TEST_ONLY,
+        request.request.clone(),
+    ) {
+        warn!(
+            planes = ?request.planes,
+            "inherited plane release rejected by TEST_ONLY: {error}"
+        );
+        return;
+    }
+    if let Err(error) = drm.atomic_commit(AtomicCommitFlags::ALLOW_MODESET, request.request) {
+        warn!(planes = ?request.planes, "inherited plane release failed: {error}");
+        return;
+    }
+    info!(
+        planes = ?request.planes,
+        "released planes inherited from the previous DRM master"
+    );
+}
+
+struct InheritedPlaneRequest {
+    request: AtomicModeReq,
+    planes: Vec<u32>,
+}
+
+fn inherited_plane_request(
+    drm: &DrmDevice,
+) -> Result<Option<InheritedPlaneRequest>, Box<dyn Error>> {
+    const DRM_PLANE_TYPE_PRIMARY: property::RawValue = 1;
+
+    let mut request = AtomicModeReq::new();
+    let mut planes = Vec::new();
+    for plane in drm.plane_handles()? {
+        let properties: Vec<(property::Handle, property::RawValue)> =
+            drm.get_properties(plane)?.into_iter().collect();
+
+        // A plane without a readable type is left alone rather than guessed at.
+        let Some(type_property) = optional_named_property(drm, plane, "type")? else {
+            continue;
+        };
+        let Some(plane_type) = property_value(&properties, type_property) else {
+            continue;
+        };
+        if plane_type == DRM_PLANE_TYPE_PRIMARY {
+            continue;
+        }
+
+        let Some(framebuffer_property) = optional_named_property(drm, plane, "FB_ID")? else {
+            continue;
+        };
+        // An unbound plane already scans out nothing.
+        if property_value(&properties, framebuffer_property).unwrap_or(0) == 0 {
+            continue;
+        }
+        let Some(crtc_property) = optional_named_property(drm, plane, "CRTC_ID")? else {
+            continue;
+        };
+
+        request.add_raw_property(plane.into(), framebuffer_property, 0);
+        request.add_raw_property(plane.into(), crtc_property, 0);
+        planes.push(u32::from(plane));
+    }
+
+    Ok((!planes.is_empty()).then_some(InheritedPlaneRequest { request, planes }))
+}
