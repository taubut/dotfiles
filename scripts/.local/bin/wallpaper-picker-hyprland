#!/bin/bash
# Wallpaper picker for Hyprland - browse wallpapers visually and apply with swaybg + wallust

WALLPAPER_DIR="${1:-$HOME/Pictures/Wallpapers}"

if [[ ! -d "$WALLPAPER_DIR" ]]; then
    echo "Wallpaper directory not found: $WALLPAPER_DIR"
    exit 1
fi

# Open nsxiv in thumbnail mode, output selected file
selected=$(nsxiv -t -o "$WALLPAPER_DIR" 2>/dev/null | head -1)

if [[ -n "$selected" ]]; then
    echo "Applying: $selected"
    # Save wallpaper path for persistence across sessions
    echo "$selected" > ~/.cache/hypr-wallpaper
    # Set wallpaper via swaybg
    pkill swaybg 2>/dev/null
    swaybg -o '*' -i "$selected" -m fill &
    # Apply wallust colors
    wallust run "$selected"
    # Restart waybar to pick up new style.css
    killall waybar 2>/dev/null
    sleep 0.5
    waybar &
    # Update Hyprland border colors from wallust palette
    if command -v hyprctl &>/dev/null; then
        get_color() { grep "^palette = $1=" ~/.config/ghostty/config | cut -d'=' -f3 | tr -d ' #'; }
        c0=$(get_color 0)
        c2=$(get_color 2)
        c4=$(get_color 4)
        c6=$(get_color 6)
        c7=$(get_color 7)
        c8=$(get_color 8)
        c10=$(get_color 10)
        c15=$(get_color 15)
        fg=$(grep "^foreground" ~/.config/ghostty/config | cut -d'=' -f2 | tr -d ' #')

        # Write colors.conf so it persists across reloads
        cat > ~/.config/hypr/config/colors.conf << EOF
# Colors generated by wallust
\$cachylgreen = rgb($c2)
\$cachymgreen = rgb($c6)
\$cachydgreen = rgb($c10)
\$cachylblue = rgb($c4)
\$cachymblue = rgb($c8)
\$cachydblue = rgb($c0)
\$cachywhite = rgb($fg)
\$cachygrey = rgb($c7)
\$cachygray = rgb($c15)
EOF
        hyprctl reload
    fi
fi
