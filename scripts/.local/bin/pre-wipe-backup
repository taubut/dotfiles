#!/usr/bin/env bash
# =============================================================================
# pre-wipe-backup — FULL mirror of your entire home to the NAS before a wipe.
# =============================================================================
# Copies ALL of $HOME (Faugus/WoW, projects, Games, Downloads, browser profiles,
# dotfiles, keys, .config, .claude — everything) to a clean, browsable folder on
# the Unraid NAS, plus a self-contained restore-from-nas.sh + README. Nothing is
# cherry-picked. You have 12 TB; we use it.
#
#   pre-wipe-backup             mirror everything (skips only the ~/Music Plex share)
#   pre-wipe-backup --with-music  ALSO copy ~/Music (your Plex library — huge/redundant)
#   pre-wipe-backup --dry-run    show what would copy, change nothing
#
# The ONLY thing skipped by default is ~/Music — it's a network mount to your
# Plex server (already safe there, not local data). Pass --with-music to include it.
# =============================================================================
set -uo pipefail

NAS_MNT="/mnt/unraid-backup"
DEST="$NAS_MNT/CachyOS-FreshStart"
DRY=0; MUSIC=0
for a in "$@"; do case "$a" in
  --dry-run) DRY=1 ;; --with-music) MUSIC=1 ;;
  -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
  *) echo "unknown arg: $a"; exit 2 ;;
esac; done

say(){ printf '%s\n' "$*"; }
hr(){ printf '\n\033[1m== %s ==\033[0m\n' "$1"; }

# --- SAFETY: NAS must be mounted (don't silently fill the local disk) --------
if ! findmnt "$NAS_MNT" >/dev/null 2>&1; then
  say "✗ NAS not mounted at $NAS_MNT — mount it first:  sudo mount $NAS_MNT"
  exit 1
fi
say "✓ NAS mounted: $(findmnt -no SOURCE "$NAS_MNT")"
say "  Destination: $DEST/home  (full mirror of \$HOME)"
[ "$DRY" = 1 ] && say "  (DRY RUN — nothing will be copied)"

# rsync flags: archive + hardlinks; -a keeps symlinks AS symlinks (so the ~/Music
# symlink won't drag in the whole Plex share). No --delete (backup stays additive).
RSYNC=(rsync -aH --info=progress2,stats2 --human-readable)
EXCLUDES=()
[ "$MUSIC" = 0 ] && EXCLUDES+=(--exclude='/Music')
[ "$DRY" = 1 ] && RSYNC+=(--dry-run)

hr "Mirroring entire home → NAS"
say "  This is large (Faugus alone is ~53G) — let it run."
mkdir -p "$DEST/home" 2>/dev/null || true
# rsync may exit 23/24 (a file vanished / perms) while copying a live home — that's OK.
"${RSYNC[@]}" "${EXCLUDES[@]}" "$HOME/" "$DEST/home/"
rc=$?
case $rc in
  0)  say "  ✓ mirror complete (clean)";;
  23) say "  ✓ mirror complete (some files unreadable/skipped — usually caches/sockets)";;
  24) say "  ✓ mirror complete (some files changed during copy — normal for a live home)";;
  *)  say "  ! rsync exit $rc — review output above";;
esac

if [ "$DRY" = 0 ]; then
  hr "Key permission safety-net (tarred, perms guaranteed)"
  mkdir -p "$DEST/keys"
  [ -d "$HOME/.ssh" ]   && tar czf "$DEST/keys/ssh.tar.gz"   -C "$HOME" .ssh   && say "  ✓ keys/ssh.tar.gz"
  [ -d "$HOME/.gnupg" ] && tar czf "$DEST/keys/gnupg.tar.gz" -C "$HOME" .gnupg && say "  ✓ keys/gnupg.tar.gz"

  hr "restore script + readme + manifest"
  cat > "$DEST/restore-from-nas.sh" <<'RESTORE'
#!/usr/bin/env bash
# Restore the full home mirror onto a fresh machine.
# Run it off the NAS (or copy this folder local first), then reboot.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
say(){ printf '%s\n' "$*"; }
say "Restoring full home from: $HERE/home  → $HOME"
read -rp "This overwrites files in $HOME with the backup. Continue? [y/N] " a
[[ "$a" =~ ^[Yy]$ ]] || { say "aborted"; exit 1; }

rsync -aH --info=progress2 --human-readable "$HERE/home/" "$HOME/"

# key permission safety (in case the NAS filesystem squashed them)
[ -f "$HERE/keys/ssh.tar.gz" ]   && { tar xzf "$HERE/keys/ssh.tar.gz"   -C "$HOME"; chmod 700 "$HOME/.ssh"   2>/dev/null; chmod 600 "$HOME/.ssh/"* 2>/dev/null; }
[ -f "$HERE/keys/gnupg.tar.gz" ] && { tar xzf "$HERE/keys/gnupg.tar.gz" -C "$HOME"; chmod 700 "$HOME/.gnupg" 2>/dev/null; }

say ""
say "Done — your home is restored. To reinstall system PACKAGES:"
say "    cd ~/dotfiles && ./fresh-start.sh --packages"
say "(configs/scripts/etc. are already here from the mirror.)"
RESTORE
  chmod +x "$DEST/restore-from-nas.sh"

  cat > "$DEST/README.txt" <<'README'
CachyOS FULL backup — a complete mirror of ~/ (home directory)
==============================================================
Everything you had is under  home/  in its original layout: Faugus (WoW/EQ),
projects, Games, Downloads, dotfiles, keys, .config, .claude, browser profiles…
The only default omission is ~/Music (your Plex network share, safe on the server).

Restore on a fresh CachyOS install:
  1. Install CachyOS (KDE Plasma). Mount this NAS (or copy this folder over).
  2. ./restore-from-nas.sh            # mirrors home/ back into ~, restores key perms
  3. cd ~/dotfiles && ./fresh-start.sh --packages   # reinstall the system packages
  4. Reboot. Re-mount Plex for ~/Music (gio mount smb://taubut@plex.local/data).

No GitHub required — your dotfiles + installer are in home/dotfiles/.
README

  {
    echo "CachyOS FULL home backup"
    echo "created: $(date '+%Y-%m-%d %H:%M:%S')   host: $(hostname)"
    echo "music included: $([ "$MUSIC" = 1 ] && echo yes || echo 'no (Plex share)')"
    echo
    echo "top-level sizes under home/:"
    du -sh "$DEST"/home/* 2>/dev/null | sort -rh | head -40
    echo; echo "grand total: $(du -sh "$DEST" 2>/dev/null | cut -f1)"
  } > "$DEST/MANIFEST.txt"
  say "  ✓ wrote restore-from-nas.sh, README.txt, MANIFEST.txt"
fi

hr "done"
[ "$DRY" = 1 ] && { say "Dry run complete — nothing copied."; exit 0; }
say "Backup folder: $DEST"
say "Total on NAS:  $(du -sh "$DEST" 2>/dev/null | cut -f1)"
say "Restore later: run  $DEST/restore-from-nas.sh  on the fresh machine."
