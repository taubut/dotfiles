#!/usr/bin/env bash
# =============================================================================
# pre-wipe-backup — back up your Linux install to the NAS before a wipe.
# =============================================================================
# MENU:
#   1) Home     full ~/ mirror                        → CachyOS-FreshStart/home
#   2) System   the config + custom bits you need to  → CachyOS-FreshStart/root
#              rebuild (NOT package fluff)
#   3) Both     1 + 2
#
# "System" grabs what's yours and hard to recreate, and is NOT in /home:
#   /etc            all system config — systemd units, network, fstab, udev, pacman.conf
#   /usr/local      your custom scripts/binaries (numlock, ferrosonic, uad, …)
#   /opt            third-party apps
#   /root           root's home
#   /var/spool/cron crontabs
# It SKIPS the fluff — /usr package files, /var caches/logs, /boot — because those
# come straight back from package-list.txt when you reinstall. Needs sudo.
#
# Flags: --home  --system  --both  |  --dry-run  --with-music.  No args = menu.
# =============================================================================
set -uo pipefail

NAS_MNT="/mnt/unraid-backup"
DEST="$NAS_MNT/CachyOS-FreshStart"
DRY=0; MUSIC=0; CHOICE=""
for a in "$@"; do case "$a" in
  --home) CHOICE="home" ;; --system) CHOICE="system" ;; --both|--everything) CHOICE="both" ;;
  --dry-run) DRY=1 ;; --with-music) MUSIC=1 ;;
  -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
  *) echo "unknown arg: $a"; exit 2 ;;
esac; done

say(){ printf '%s\n' "$*"; }
hr(){ printf '\n\033[1m== %s ==\033[0m\n' "$1"; }

findmnt "$NAS_MNT" >/dev/null 2>&1 || { say "✗ NAS not mounted at $NAS_MNT — run: sudo mount $NAS_MNT"; exit 1; }

# ---------------------------------------------------------------------------
backup_home() {
  hr "HOME — full mirror of \$HOME  → $DEST/home"
  local RSYNC=(rsync -a --no-owner --no-group --no-D --info=progress2,stats2 --human-readable)
  local EX=(); [ "$MUSIC" = 0 ] && EX+=(--exclude='/Music')
  [ "$DRY" = 1 ] && RSYNC+=(--dry-run)
  mkdir -p "$DEST/home" 2>/dev/null || true
  "${RSYNC[@]}" "${EX[@]}" "$HOME/" "$DEST/home/"
  case $? in 0) say "  ✓ home complete";; 23|24) say "  ✓ home complete (minor attr/vanished skips)";; *) say "  ! re-run to finish";; esac
  [ "$DRY" = 1 ] && return
  hr "Keys (tarred, perms guaranteed)"
  mkdir -p "$DEST/keys"
  [ -d "$HOME/.ssh" ]   && tar czf "$DEST/keys/ssh.tar.gz"   -C "$HOME" .ssh   && say "  ✓ keys/ssh.tar.gz"
  [ -d "$HOME/.gnupg" ] && tar czf "$DEST/keys/gnupg.tar.gz" -C "$HOME" .gnupg && say "  ✓ keys/gnupg.tar.gz"
}

# ---------------------------------------------------------------------------
backup_system() {
  hr "SYSTEM — config + custom bits (what you need to rebuild)  → $DEST/root"
  say "  Grabbing: /etc (systemd units, network, fstab, udev, pacman.conf…), /usr/local,"
  say "  /opt, /root, crontabs, + pacman cache (offline/AUR reinstall insurance ~13G)."
  say "  Skipping package fluff in /usr (comes back from package-list). Needs sudo…"
  sudo -v || { say "  ✗ sudo required for the system backup"; return 1; }
  mkdir -p "$DEST/root"
  local FL=(-aR --no-owner --no-group --no-D --info=progress2,stats2 --human-readable)
  [ "$DRY" = 1 ] && FL+=(--dry-run)
  local p
  for p in /etc /usr/local /opt /root /var/spool/cron /var/cache/pacman/pkg; do
    [ -e "$p" ] || continue
    sudo rsync "${FL[@]}" "$p" "$DEST/root/" 2>/dev/null && say "  ✓ $p" || say "  ~ $p (some attrs skipped — fine)"
  done
  say "  ✓ system config + pacman cache saved"
}

# ---------------------------------------------------------------------------
save_lists() {
  [ "$DRY" = 1 ] && return
  hr "Enabled-services + package lists (quick reference)"
  mkdir -p "$DEST/system-state"
  id -nG > "$DEST/system-state/groups.txt" 2>/dev/null && say "  ✓ groups.txt"
  systemctl list-unit-files --state=enabled --no-legend 2>/dev/null | awk '{print $1}' > "$DEST/system-state/services-system.txt" && say "  ✓ services-system.txt (enabled system services)"
  systemctl --user list-unit-files --state=enabled --no-legend 2>/dev/null | awk '{print $1}' > "$DEST/system-state/services-user.txt" && say "  ✓ services-user.txt (enabled user services)"
  pacman -Qqe > "$DEST/system-state/packages-explicit.txt" 2>/dev/null && say "  ✓ packages-explicit.txt"
}

# ---------------------------------------------------------------------------
write_meta() {
  [ "$DRY" = 1 ] && return
  hr "restore helper + readme"
  cat > "$DEST/restore-from-nas.sh" <<'RESTORE'
#!/usr/bin/env bash
# Restore on a fresh machine. Run from inside this backup folder.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
say(){ printf '%s\n' "$*"; }
say "Restoring HOME → $HOME"
read -rp "Overwrites files in your home with the backup. Continue? [y/N] " a
[[ "$a" =~ ^[Yy]$ ]] || exit 1
rsync -a --no-owner --no-group --no-D --info=progress2 "$HERE/home/" "$HOME/"
[ -f "$HERE/keys/ssh.tar.gz" ]   && { tar xzf "$HERE/keys/ssh.tar.gz"   -C "$HOME"; chmod 700 "$HOME/.ssh" 2>/dev/null; chmod 600 "$HOME/.ssh/"* 2>/dev/null; }
[ -f "$HERE/keys/gnupg.tar.gz" ] && { tar xzf "$HERE/keys/gnupg.tar.gz" -C "$HOME"; chmod 700 "$HOME/.gnupg" 2>/dev/null; }
say ""
say "HOME restored. Now:"
say "  cd ~/dotfiles && ./fresh-start.sh --packages   # reinstall your programs"
say "  cd ~/dotfiles && ./fresh-start.sh --system     # groups + re-enable services"
say ""
say "System config is in  root/  — pull back what you need, e.g.:"
say "  sudo cp -a root/usr/local/.  /usr/local/                       # custom scripts"
say "  sudo cp root/etc/systemd/system/numlock.service /etc/systemd/system/"
say "  sudo cp -r root/etc/NetworkManager/system-connections /etc/NetworkManager/  # WiFi"
say "(Don't blind-copy ALL of root/etc over a fresh install — cherry-pick.)"
RESTORE
  chmod +x "$DEST/restore-from-nas.sh"
  cat > "$DEST/README.txt" <<'README'
CachyOS backup
==============
  home/          full mirror of ~/ (everything under /home/taubut, minus ~/Music)
  root/          system config + custom bits: /etc (all config incl. systemd units,
                 network, fstab, udev), /usr/local (your scripts/binaries), /opt, /root,
                 crontabs. NOT package files (those reinstall from package-list.txt).
  keys/          ssh + gnupg (tarred, perms preserved) — KEEP PRIVATE
  system-state/  enabled services, groups, package list (quick reference)

Rebuild: install CachyOS → ./restore-from-nas.sh (home) →
  cd ~/dotfiles && ./fresh-start.sh --packages && ./fresh-start.sh --system
Then cherry-pick any system config you need from root/.
README
  say "  ✓ restore-from-nas.sh, README.txt"
}

# ---------------------------------------------------------------------------
run() { case "$1" in
    home)   backup_home; save_lists; write_meta ;;
    system) backup_system; save_lists; write_meta ;;
    both)   backup_home; backup_system; save_lists; write_meta ;;
  esac; }

if [ -n "$CHOICE" ]; then run "$CHOICE"
else
  cat <<EOF

  What do you want to back up?  (NAS: $(df -h --output=avail "$NAS_MNT" | tail -1 | tr -d ' ') free)
  ───────────────────────────────────────────────────────────────────
   1) Home     full ~/ mirror                                → home/
   2) System   config + custom scripts + services (no fluff) → root/
   3) Both     home + system
   q) quit
  ───────────────────────────────────────────────────────────────────
EOF
  read -rp "  choose: " c
  case "${c,,}" in
    1) run home ;; 2) run system ;; 3) run both ;;
    *) say "  nothing done."; exit 0 ;;
  esac
fi

say ""
say "Done.  Backup folder: $DEST"
say "Restore later:  $DEST/restore-from-nas.sh"
