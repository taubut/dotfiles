#!/usr/bin/env bash
# =============================================================================
# drive-backup-selective — navigate a drive and back up exactly what you pick.
# =============================================================================
# Browse the drive like a file tree: open folders (→), go back (←), and tick
# (SPACE) what to back up at ANY depth. Tick a folder to take all of it, or open
# it and un-tick the junk inside (e.g. keep Users, skip Users/…/AppData). Shows
# each folder's size (GiB) + a running "selected" total. rsyncs only your picks.
# Resumable.
#
#   drive-backup-selective                 pick a drive, then browse + tick
#   drive-backup-selective <mount> [name]  browse a specific drive
#   drive-backup-selective --check <mount> [name]        verify the backup (fast)
#   drive-backup-selective --check --deep <mount> [name] verify byte-for-byte (slow)
#
# --check only looks at what's IN the backup — folders/files you skipped are
# ignored (no false "missing" alarms). It flags any backed-up file that doesn't
# match the drive. --deep adds full checksums (re-reads everything; slow).
# Destination: /mnt/unraid-backup/windows-backup/<name>/
# =============================================================================
set -uo pipefail

NAS_MNT="/mnt/unraid-backup"
DEST_ROOT="$NAS_MNT/windows-backup"
MODE="pick"; DEEP=0
while :; do case "${1:-}" in
  --check) MODE="check"; shift ;;
  --deep)  DEEP=1; shift ;;
  -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
  *) break ;;
esac; done
findmnt "$NAS_MNT" >/dev/null 2>&1 || { echo "✗ NAS not mounted at $NAS_MNT — sudo mount $NAS_MNT"; exit 1; }

DRIVES=( "2ndPro|/mnt/2ndPro|2ndPro" "980Pro|/run/media/taubut/980Pro|980Pro" "Basic Data|/run/media/taubut/E2C02718C026F289|Basic-Data" )
if [ -n "${1:-}" ]; then
  SRC="$1"; NAME="${2:-$(basename "$SRC")}"
else
  avail=(); for d in "${DRIVES[@]}"; do IFS='|' read -r lbl mnt nm <<<"$d"; findmnt "$mnt" >/dev/null 2>&1 && avail+=("$d"); done
  [ "${#avail[@]}" -eq 0 ] && { echo "No NTFS drives mounted."; exit 1; }
  echo "  Which drive?"; i=1
  for d in "${avail[@]}"; do IFS='|' read -r lbl mnt nm <<<"$d"; printf "   %d) %-12s %s\n" "$i" "$lbl" "$mnt"; i=$((i+1)); done
  echo "   q) quit"; read -rp "  choose: " c
  { [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 1 ] && [ "$c" -le "${#avail[@]}" ]; } || { echo "  bye"; exit 0; }
  IFS='|' read -r _ SRC NAME <<<"${avail[$((c-1))]}"
fi
DEST="$DEST_ROOT/$NAME"
findmnt "$SRC" >/dev/null 2>&1 || { echo "✗ not a mounted drive: $SRC"; exit 1; }

FLAGS=( -rlt --no-perms --no-owner --no-group --no-D --modify-window=2 --partial
        --human-readable --info=progress2,stats2
        --exclude='.Trash-*' --exclude='$RECYCLE.BIN' --exclude='System Volume Information' )
fmtG(){ awk -v b="${1:-0}" 'BEGIN{printf "%8.1f GiB", b/1073741824}'; }
skip(){ case "$1" in '.Trash-'*|'$RECYCLE.BIN'|'System Volume Information'|hiberfil.sys|pagefile.sys|swapfile.sys) return 0;; *) return 1;; esac; }

# ---------- VERIFY (only checks what's IN the backup; ignores what you skipped) ----------
if [ "$MODE" = "check" ]; then
  [ -d "$DEST" ] || { echo "no backup at $DEST"; exit 1; }
  CK=( -rlt --no-perms --no-owner --no-group --no-D --modify-window=2 --dry-run --itemize-changes
       --exclude='.Trash-*' --exclude='$RECYCLE.BIN' --exclude='System Volume Information' )
  if [ "$DEEP" = 1 ]; then CK+=(--checksum); echo "== Deep verify (byte-for-byte — re-reads everything, slow) =="
  else echo "== Verify: every backed-up file present + matches the drive =="; fi
  echo "  (only what's in the backup is checked — folders/files you skipped are ignored)"
  echo "  ────────────────────────────────────────────────────────────"
  bad=0
  while IFS= read -r n; do
    # keep only FILE lines (^.f) that already exist in the backup but differ.
    # '+++' lines = files on the drive that aren't in the backup = your skips → ignored.
    out="$(rsync "${CK[@]}" "$SRC/$n" "$DEST/" 2>/dev/null | grep -E '^.f' | grep -vE '\+\+\+' || true)"
    if [ -z "$out" ]; then printf "  \033[32m✓\033[0m %s\n" "$n"
    else printf "  \033[31m✗\033[0m %s — these backed-up files DON'T match the drive:\n" "$n"; echo "$out" | sed 's/^/        /'; bad=1; fi
  done < <( cd "$DEST" && find . -mindepth 1 -maxdepth 1 -printf '%P\n' | sort )
  echo "  ────────────────────────────────────────────────────────────"
  if [ "$bad" = 0 ]; then echo "  ✓ Everything in the backup matches the drive — safe to wipe it."
  else echo "  ✗ Some files above didn't match — re-run the backup for those folders, then re-check."; fi
  exit 0
fi

# ---------- TREE NAVIGATOR ----------
declare -A SELECTED EXCLUDED
CURDIR=""; cursor=0; SELSIZE=0

relpath(){ printf '%s' "${CURDIR:+$CURDIR/}$1"; }
# included: nearest ancestor-or-self decides (deeper wins). exclude beats include.
included(){ local p="$1"
  while :; do
    [ -n "${EXCLUDED[$p]:-}" ] && return 1
    [ -n "${SELECTED[$p]:-}" ] && return 0
    [[ "$p" == */* ]] || return 1
    p="${p%/*}"
  done
}
has_selected_descendant(){ local p="$1" s; for s in "${!SELECTED[@]}"; do [[ "$s" == "$p/"* ]] && return 0; done; return 1; }

measure(){ NAMES=(); BYTES=(); ISDIR=(); local base="$SRC${CURDIR:+/$CURDIR}" b p n
  while IFS=$'\t' read -r b p; do n="${p##*/}"; skip "$n" && continue
    NAMES+=("$n"); BYTES+=("$b"); [ -d "$base/$n" ] && ISDIR+=(1) || ISDIR+=(0)
  done < <(du -sb "$base"/* 2>/dev/null | sort -rn)
  N=${#NAMES[@]}; ((cursor>=N)) && cursor=$((N>0?N-1:0))
}

draw(){ printf '\033[H\033[J'
  echo "  Browse & pick   ↑/↓ move · → open · ← back · SPACE tick · a all · g GO · q quit"
  printf "  %s   path: /%s\n" "$NAME" "$CURDIR"
  printf "  selected so far: \033[1m%s\033[0m\n" "$(fmtG "$SELSIZE")"
  echo "  ──────────────────────────────────────────────────────────────"
  [ "$N" -eq 0 ] && echo "    (empty)"
  local i box mark rp st
  for ((i=0;i<N;i++)); do
    rp="$(relpath "${NAMES[$i]}")"
    if included "$rp"; then box="[✓]"
    elif has_selected_descendant "$rp"; then box="[~]"
    else box="[ ]"; fi
    [ "${ISDIR[$i]}" = 1 ] && mark="▸" || mark=" "
    local line; line="$(printf "%s %s %s   %s" "$box" "$mark" "$(fmtG ${BYTES[$i]})" "${NAMES[$i]}")"
    if [ "$i" = "$cursor" ]; then printf "  \033[7m❯ %s\033[0m\n" "$line"; else printf "    %s\n" "$line"; fi
  done
  echo "  ──────────────────────────────────────────────────────────────"
  echo "  [✓]=all of it · [~]=some inside · tick a folder then open it to skip bits"
}

toggle(){ local rp="$1" sz="$2"
  if included "$rp"; then
    if [ -n "${SELECTED[$rp]:-}" ]; then unset "SELECTED[$rp]"; else EXCLUDED[$rp]=1; fi
    SELSIZE=$((SELSIZE - sz))
  else
    if [ -n "${EXCLUDED[$rp]:-}" ]; then unset "EXCLUDED[$rp]"; else SELECTED[$rp]=1; fi
    SELSIZE=$((SELSIZE + sz))
  fi
  ((SELSIZE<0)) && SELSIZE=0
}

echo "Measuring top-level sizes on $SRC … (a minute on a big drive)"; measure
while true; do
  draw
  IFS= read -rsn1 key
  [[ "$key" == $'\x1b' ]] && { IFS= read -rsn2 -t 0.05 r || true; key+="${r:-}"; }
  case "$key" in
    $'\x1b[A'|k) if ((cursor>0)); then ((cursor--)); else cursor=$((N>0?N-1:0)); fi ;;
    $'\x1b[B'|j) if ((N>0 && cursor<N-1)); then ((cursor++)); else cursor=0; fi ;;
    $'\x1b[C'|l) if [ "$N" -gt 0 ] && [ "${ISDIR[$cursor]}" = 1 ]; then CURDIR="$(relpath "${NAMES[$cursor]}")"; echo "  opening ${NAMES[$cursor]} …"; measure; cursor=0; fi ;;
    $'\x1b[D'|h) if [ -n "$CURDIR" ]; then if [[ "$CURDIR" == */* ]]; then CURDIR="${CURDIR%/*}"; else CURDIR=""; fi; measure; cursor=0; fi ;;
    ' ') [ "$N" -gt 0 ] && toggle "$(relpath "${NAMES[$cursor]}")" "${BYTES[$cursor]}" ;;
    a|A) for ((i=0;i<N;i++)); do rp="$(relpath "${NAMES[$i]}")"; included "$rp" || toggle "$rp" "${BYTES[$i]}"; done ;;
    g|G) break ;;
    q|Q) printf '\033[H\033[J'; echo "  cancelled — nothing copied."; exit 0 ;;
  esac
done
printf '\033[H\033[J'

# ---------- collect top-most selected paths (drop ones covered by a selected ancestor) ----------
picks=()
for sp in "${!SELECTED[@]}"; do
  anc="$sp"; covered=0
  while [[ "$anc" == */* ]]; do anc="${anc%/*}"; [ -n "${SELECTED[$anc]:-}" ] && { covered=1; break; }; done
  [ "$covered" = 0 ] && picks+=("$sp")
done
[ "${#picks[@]}" -eq 0 ] && { echo "  nothing selected."; exit 0; }

echo "  Backing up (≈ $(fmtG "$SELSIZE")):"
for sp in "${picks[@]}"; do
  exwithin=""; for ep in "${!EXCLUDED[@]}"; do [[ "$ep" == "$sp/"* ]] && exwithin+=" (skip ${ep#$sp/})"; done
  echo "    • $sp$exwithin"
done
read -rp "  Proceed? [y/N] " ok; [[ "${ok,,}" == y* ]] || { echo "  cancelled."; exit 0; }

mkdir -p "$DEST"
for sp in "${picks[@]}"; do
  printf '\n\033[1m══ %s ══\033[0m\n' "$sp"
  exargs=(); for ep in "${!EXCLUDED[@]}"; do [[ "$ep" == "$sp/"* ]] && exargs+=(--exclude="/$ep"); done
  rsync "${FLAGS[@]}" "${exargs[@]}" -R "$SRC/./$sp" "$DEST/"
  case $? in 0) echo "  ✓ done";; 24) echo "  ✓ done (a few files changed mid-copy — re-run)";; *) echo "  ! re-run to finish";; esac
done
echo; echo "  Done. Verify before trusting:  drive-backup-selective --check \"$SRC\" \"$NAME\""
