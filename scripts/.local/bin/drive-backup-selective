#!/usr/bin/env bash
# =============================================================================
# drive-backup-selective — pick which top-level folders of a drive to back up.
# =============================================================================
# For the big NTFS drives: instead of copying the WHOLE drive, it measures each
# top-level folder's size, shows a checklist (↑/↓ · SPACE · ENTER), and rsyncs
# only what you tick — so you skip games/Windows/Python junk you'll never restore.
# Resumable (Ctrl-C + re-run). Verify with --check afterward.
#
#   drive-backup-selective <mount> [name]           pick + back up
#   drive-backup-selective --check <mount> [name]   verify (checksum) what's in the backup
#
# Examples:
#   drive-backup-selective /run/media/taubut/980Pro 980Pro
#   drive-backup-selective "/run/media/taubut/E2C02718C026F289" Basic-Data
# Destination: /mnt/unraid-backup/windows-backup/<name>/
# =============================================================================
set -uo pipefail

NAS_MNT="/mnt/unraid-backup"
DEST_ROOT="$NAS_MNT/windows-backup"
MODE="pick"
case "${1:-}" in
  --check) MODE="check"; shift ;;
  -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
esac
SRC="${1:?usage: drive-backup-selective [--check] <mount> [name]}"
NAME="${2:-$(basename "$SRC")}"
DEST="$DEST_ROOT/$NAME"

findmnt "$NAS_MNT" >/dev/null 2>&1 || { echo "✗ NAS not mounted at $NAS_MNT — sudo mount $NAS_MNT"; exit 1; }
findmnt "$SRC"     >/dev/null 2>&1 || { echo "✗ source is not a mounted drive: $SRC"; exit 1; }

# rsync flags — NTFS-friendly + skip trash/recycle/system junk
FLAGS=( -rlt --no-perms --no-owner --no-group --no-D --modify-window=2 --partial
        --human-readable --info=progress2,stats2
        --exclude='.Trash-*' --exclude='$RECYCLE.BIN' --exclude='System Volume Information' )
fmtG(){ awk -v b="${1:-0}" 'BEGIN{printf "%8.1f GiB", b/1073741824}'; }
skip(){ case "$1" in '.Trash-'*|'$RECYCLE.BIN'|'System Volume Information'|hiberfil.sys|pagefile.sys|swapfile.sys) return 0;; *) return 1;; esac; }

# ---------- VERIFY MODE ----------
if [ "$MODE" = "check" ]; then
  [ -d "$DEST" ] || { echo "no backup folder at $DEST"; exit 1; }
  echo "== Verifying each backed-up folder against the drive (checksum) =="
  for d in "$DEST"/*/; do
    [ -d "$d" ] || continue
    n="$(basename "$d")"
    echo "── $n"
    rsync "${FLAGS[@]}" --checksum --dry-run --itemize-changes "$SRC/$n/" "$d" 2>/dev/null
  done
  echo "== any lines above a folder = differences; none = that folder is a perfect match =="
  exit 0
fi

# ---------- MEASURE TOP-LEVEL SIZES ----------
echo "Measuring top-level folder sizes on $SRC …"
echo "(this can take a minute on a big drive — it's reading the whole tree once)"
NAMES=(); BYTES=(); SEL=()
while IFS=$'\t' read -r b p; do
  n="${p##*/}"; skip "$n" && continue
  NAMES+=("$n"); BYTES+=("$b"); SEL+=(0)
done < <(du -sb "$SRC"/* 2>/dev/null | sort -rn)
N=${#NAMES[@]}
[ "$N" -eq 0 ] && { echo "nothing to back up on $SRC"; exit 0; }

total=0; for ((i=0;i<N;i++)); do total=$((total+${BYTES[$i]})); done

# ---------- CHECKLIST (arrow keys) ----------
cursor=0
draw(){
  printf '\033[H\033[J'
  local seltot=0 i
  for ((i=0;i<N;i++)); do [ "${SEL[$i]}" = 1 ] && seltot=$((seltot+${BYTES[$i]})); done
  echo "  Pick folders to back up   ↑/↓ move · SPACE tick · a all/none · ENTER start · q quit"
  echo "  drive: $SRC   →   windows-backup/$NAME"
  printf "  selected: \033[1m%s\033[0m   of   %s on the drive\n" "$(fmtG $seltot)" "$(fmtG $total)"
  echo "  ──────────────────────────────────────────────────────────────"
  for ((i=0;i<N;i++)); do
    local box="[ ]"; [ "${SEL[$i]}" = 1 ] && box="[✓]"
    local line; line="$(printf "%s  %s   %s" "$box" "$(fmtG ${BYTES[$i]})" "${NAMES[$i]}")"
    if [ "$i" = "$cursor" ]; then printf "  \033[7m❯ %s\033[0m\n" "$line"; else printf "    %s\n" "$line"; fi
  done
  echo "  ──────────────────────────────────────────────────────────────"
  echo "  Tip: quit (q), go look at these folders yourself, then re-run to pick."
}
while true; do
  draw
  IFS= read -rsn1 key
  [[ "$key" == $'\x1b' ]] && { IFS= read -rsn2 -t 0.05 r || true; key+="${r:-}"; }
  case "$key" in
    $'\x1b[A'|k|K) if ((cursor>0)); then ((cursor--)); else cursor=$((N-1)); fi ;;
    $'\x1b[B'|j|J) if ((cursor<N-1)); then ((cursor++)); else cursor=0; fi ;;
    ' ')  SEL[$cursor]=$((1-${SEL[$cursor]})) ;;
    a|A)  as=1; for ((i=0;i<N;i++)); do [ "${SEL[$i]}" = 1 ] || as=0; done
          for ((i=0;i<N;i++)); do [ "$as" = 1 ] && SEL[$i]=0 || SEL[$i]=1; done ;;
    q|Q)  printf '\033[H\033[J'; echo "  cancelled — nothing copied."; exit 0 ;;
    ''|$'\n'|$'\r') break ;;
  esac
done
printf '\033[H\033[J'

# ---------- collect + confirm ----------
chosen=(); ctot=0
for ((i=0;i<N;i++)); do [ "${SEL[$i]}" = 1 ] && { chosen+=("$i"); ctot=$((ctot+${BYTES[$i]})); }; done
[ "${#chosen[@]}" -eq 0 ] && { echo "  nothing selected."; exit 0; }
echo "  Backing up ${#chosen[@]} folder(s), $(fmtG $ctot):"
for i in "${chosen[@]}"; do echo "    • ${NAMES[$i]}  ($(fmtG ${BYTES[$i]}))"; done
read -rp "  Proceed? [y/N] " ok
[[ "${ok,,}" == y* ]] || { echo "  cancelled."; exit 0; }

# ---------- back up each selected folder ----------
mkdir -p "$DEST"
for i in "${chosen[@]}"; do
  printf '\n\033[1m══ %s ══\033[0m\n' "${NAMES[$i]}"
  rsync "${FLAGS[@]}" "$SRC/${NAMES[$i]}" "$DEST/"
  case $? in 0) echo "  ✓ done";; 24) echo "  ✓ done (a few files changed mid-copy — re-run to catch)";; *) echo "  ! re-run to finish";; esac
done
echo
echo "  All selected folders copied. Verify before trusting:"
echo "    drive-backup-selective --check \"$SRC\" \"$NAME\""
echo "  (keep the drive originals until --check is clean)"
