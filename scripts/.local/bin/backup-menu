#!/usr/bin/env bash
# =============================================================================
# backup-menu — interactive picker for NAS backups (run in YOUR terminal)
# =============================================================================
# ↑/↓ (or j/k) move · SPACE toggles · number toggles that row · a = all/none ·
# ENTER starts · q quits. Runs each selected target in sequence (never parallel)
# via pre-wipe-backup / drive-backup, clean single-line % progress, then offers
# a checksum verify for the drives. Resumable. LAN transfer; internet-independent.
# =============================================================================
set -uo pipefail

NAS_MNT="/mnt/unraid-backup"
findmnt "$NAS_MNT" >/dev/null 2>&1 || { echo "✗ NAS not mounted at $NAS_MNT — run: sudo mount $NAS_MNT"; exit 1; }

# --- targets: TYPE|LABEL|SOURCE|DESTNAME  (drives listed only if mounted) ----
TARGETS=()
TARGETS+=("home|Linux home (dotfiles, Faugus/WoW, configs…)|$HOME|-")
for spec in \
  "2ndPro drive|/mnt/2ndPro|2ndPro" \
  "980Pro drive|/run/media/taubut/980Pro|980Pro" \
  "Basic Data partition|/run/media/taubut/E2C02718C026F289|Basic-Data"; do
  IFS='|' read -r lbl src nm <<<"$spec"
  findmnt "$src" >/dev/null 2>&1 && TARGETS+=("drive|$lbl|$src|$nm")
done
N=${#TARGETS[@]}

HOME_RUNNING=0
pgrep -f 'rsync.*CachyOS-FreshStart' >/dev/null 2>&1 && HOME_RUNNING=1
FREE="$(df -h --output=avail "$NAS_MNT" 2>/dev/null | tail -1 | tr -d ' ')"

# precompute used-space per target (once, so redraws are instant)
SEL=(); USED=()
for ((i=0; i<N; i++)); do
  SEL+=(0)
  IFS='|' read -r type lbl src nm <<<"${TARGETS[$i]}"
  [ "$type" = drive ] && USED+=("$(df -h --output=used "$src" 2>/dev/null | tail -1 | tr -d ' ')") || USED+=("-")
done

cursor=0
draw(){
  printf '\033[H\033[J'
  echo
  echo "  Backup picker   ↑/↓ move · SPACE check · ENTER start · q quit   (NAS: $FREE free)"
  echo "  ──────────────────────────────────────────────────────────────────────"
  local i type lbl src nm box line
  for ((i=0; i<N; i++)); do
    IFS='|' read -r type lbl src nm <<<"${TARGETS[$i]}"
    box="[ ]"; [ "${SEL[$i]}" = 1 ] && box="[✓]"
    if [ "$type" = home ]; then
      line=$(printf "%s  %-40s → CachyOS-FreshStart/home%s" "$box" "$lbl" "$([ "$HOME_RUNNING" = 1 ] && printf '  ⏳ running elsewhere')")
    else
      line=$(printf "%s  %-26s (%6s) → windows-backup/%s" "$box" "$lbl" "${USED[$i]}" "$nm")
    fi
    if [ "$i" = "$cursor" ]; then printf "  \033[7m ❯ %s \033[0m\n" "$line"
    else printf "     %s\n" "$line"; fi
  done
  echo "  ──────────────────────────────────────────────────────────────────────"
  echo "   a = check/uncheck all"
}

# --- selection loop (arrow keys / space / numbers) ---------------------------
while true; do
  draw
  IFS= read -rsn1 key
  if [[ "$key" == $'\x1b' ]]; then IFS= read -rsn2 -t 0.05 rest || true; key+="${rest:-}"; fi
  case "$key" in
    $'\x1b[A'|k|K) if ((cursor>0)); then ((cursor--)); else cursor=$((N-1)); fi ;;
    $'\x1b[B'|j|J) if ((cursor<N-1)); then ((cursor++)); else cursor=0; fi ;;
    ' ')  SEL[$cursor]=$((1-${SEL[$cursor]})) ;;
    [1-9]) if [ "$key" -ge 1 ] && [ "$key" -le "$N" ]; then cursor=$((key-1)); SEL[$cursor]=$((1-${SEL[$cursor]})); fi ;;
    a|A)  allsel=1; for ((i=0; i<N; i++)); do [ "${SEL[$i]}" = 1 ] || allsel=0; done
          for ((i=0; i<N; i++)); do [ "$allsel" = 1 ] && SEL[$i]=0 || SEL[$i]=1; done ;;
    q|Q)  printf '\033[H\033[J'; echo "  cancelled."; exit 0 ;;
    ''|$'\n'|$'\r') break ;;
  esac
done
printf '\033[H\033[J'

# --- collect + confirm -------------------------------------------------------
chosen=(); for ((i=0; i<N; i++)); do [ "${SEL[$i]}" = 1 ] && chosen+=("$i"); done
[ "${#chosen[@]}" -eq 0 ] && { echo "  nothing selected."; exit 0; }

for i in "${chosen[@]}"; do
  IFS='|' read -r type lbl src nm <<<"${TARGETS[$i]}"
  if [ "$type" = home ] && [ "$HOME_RUNNING" = 1 ]; then
    read -rp "  Home backup is already running elsewhere — run it here too? [y/N] " a
    [[ "${a,,}" == y* ]] || { echo "  Re-open the menu and leave home unchecked."; exit 0; }
  fi
done

echo "  Will back up (one at a time, in order):"
for i in "${chosen[@]}"; do IFS='|' read -r type lbl src nm <<<"${TARGETS[$i]}"; echo "    • $lbl"; done
[ "$HOME_RUNNING" = 1 ] && echo "  Note: a home backup is running elsewhere — these will share NAS bandwidth."
read -rp "  Proceed? [y/N] " ok
[[ "${ok,,}" == y* ]] || { echo "  cancelled."; exit 0; }

# --- run each selected target sequentially -----------------------------------
did_drive=0
for i in "${chosen[@]}"; do
  IFS='|' read -r type lbl src nm <<<"${TARGETS[$i]}"
  printf '\n\033[1m══ %s ══\033[0m\n' "$lbl"
  if [ "$type" = home ]; then pre-wipe-backup
  else drive-backup "$src" "$nm"; did_drive=1; fi
done

# --- offer checksum verify for any drives we backed up -----------------------
if [ "$did_drive" = 1 ]; then
  echo
  read -rp "  Verify the drive backup(s) by checksum now? (recommended before a wipe) [y/N] " v
  if [[ "${v,,}" == y* ]]; then
    for i in "${chosen[@]}"; do
      IFS='|' read -r type lbl src nm <<<"${TARGETS[$i]}"
      [ "$type" = drive ] || continue
      printf '\n\033[1m══ verify: %s ══\033[0m\n' "$lbl"
      drive-backup --check "$src" "$nm"
    done
  fi
fi
echo; echo "  Done. Keep drive originals until --check shows a clean match."
